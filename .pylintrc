[MAIN]

# Specify a score threshold under which the program will exit with error.
fail-under=8

# Packages whitelist where C extensions may be loaded
extension-pkg-allow-list=pygame

[BASIC]

# Regular expression which should only match function or class names that do not require a docstring.
no-docstring-rgx=^.*

[DESIGN]

# List of regular expressions of class ancestor names to ignore when counting public methods (see R0903)
exclude-too-few-public-methods=^.*

[FORMAT]

# Maximum number of characters on a single line
max-line-length=180

# Maximum number of lines in a module.
max-module-lines=1000

[MESSAGES CONTROL]

disable=missing-module-docstring, too-few-public-methods, fixme, unused-import, wildcard-import, unused-wildcard-import
